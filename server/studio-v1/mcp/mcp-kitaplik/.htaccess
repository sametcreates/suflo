# Suflo Studio MCP kitapligi (public_html/<uygulama>/mcp-kitaplik/): disariya tamamen kapali.
# Bu PHP dosyalari yalniz mcp-giris.php / oauth-giris.php / kesif-giris.php icinden yuklenir; dogrudan cagrilirsa da bir sey yapmazlar.
Options -Indexes
<IfModule mod_authz_core.c>
  Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
  Order allow,deny
  Deny from all
</IfModule>
